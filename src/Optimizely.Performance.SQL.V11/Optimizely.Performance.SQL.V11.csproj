<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Optimizely.Performance.SQL.V11</RootNamespace>
    <AssemblyName>Optimizely.Performance.SQL.V11</AssemblyName>
    <PackageId>Optimizely.Performance.SQL.V11</PackageId>
    <Description>Optimizely CMS 11 adapter for the approved-SQL rewrite shim. Patches System.Data.SqlClient.SqlCommand's execution methods at runtime and substitutes approved statement text immediately before execution.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optimizely.Performance.SQL.Core\Optimizely.Performance.SQL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The in-box System.Data.SqlClient has no DiagnosticSource, so CMS 11 cannot be
      intercepted the way CMS 12 is. Harmony patches the execution methods directly.
      Nothing else in this package depends on it: if patching is refused, the adapter
      reports that and the site runs unrewritten.
    -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The patch target set is the thing most likely to rot, so the tests assert on it directly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Optimizely.Performance.SQL.V11.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- PreApplicationStartMethod, for the earliest managed hook ASP.NET offers. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Data" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

</Project>
